# web-plataform — variáveis de ambiente.
# Copie para .env.local (gitignored) para rodar localmente.

# --- Obrigatórias (o app não sobe sem elas) ---
# Chaves PÚBLICAS do Supabase (vão no bundle do browser, NÃO são segredo).
# Valores do projeto NeuroRace (públicos por design; um fork usa os seus). Ver docs/PLANO.md.
NEXT_PUBLIC_SUPABASE_URL=https://wtaulbdkgrnrtbfezaxw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JpFFIWudbZ3GxR04QINxog_GqGk7dpw

# --- Opcional ---
# URL canônica do site (metadataBase/OG e links de share). Sem ela, usa https://neurorace-v2.vercel.app.
# NEXT_PUBLIC_SITE_URL=https://neurorace-v2.vercel.app

# --- Opcionais: SÓ para scripts/seed-demo.mjs (semear o dashboard local). O app NÃO usa. ---
# SEED_EMAIL=voce@exemplo.com     # e-mail já cadastrado e confirmado
# SEED_RACES=3                    # quantas corridas gerar
# SEED_DRY=1                      # dry-run (não envia)
# EDGE_INGEST_TOKEN=dev-only-change-me
# SUPABASE_SERVICE_ROLE_KEY=      # SEGREDO — nunca commitar; deixe só no .env.local

# --- Opcionais: NeuroCoach (IA Coach, NEU-115) ---
# Sem a IA ligada, o NeuroCoach funciona com o texto-modelo (mesmo conteúdo, sem IA).
# Ligada, o texto é escrito pela Groq só para quem deu o consentimento LGPD, 1 vez por corrida (cache).
# A IA só liga com as DUAS abaixo. Em produção, NEUROCOACH_AI_ENABLED=true só depois de
# verificar a política de retenção/treino da Groq (ADR 0003 §6, NEU-94).
# NEUROCOACH_AI_ENABLED=true        # liga/desliga explícito (qualquer outro valor = desligada)
# GROQ_API_KEY=                     # SEGREDO — Vercel e .env.local; nunca commitar
# GROQ_MODEL=openai/gpt-oss-120b    # opcional; padrão acima
